<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Android 9+ blocks cleartext HTTP by default, which stops
  the app talking to a local Laravel dev server over http://. Release builds do
  not include this file and stay HTTPS-only.
-->
<network-security-config>
    <!-- Local development hosts, including the emulator's alias for the host
         machine (10.0.2.2). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">giwubible.test</domain>
        <domain includeSubdomains="true">api.giwu.test</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>

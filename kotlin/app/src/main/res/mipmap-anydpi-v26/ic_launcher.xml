<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="16%" />
    </foreground>
    <!-- Themed icons on Android 13+ tint this layer, so it reuses the
         foreground artwork rather than shipping a separate asset. -->
    <monochrome>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="16%" />
    </monochrome>
</adaptive-icon>

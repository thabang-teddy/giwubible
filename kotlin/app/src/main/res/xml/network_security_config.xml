<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic must be HTTPS. The Settings screen lets the reader
         point the app at a local Laravel instance, so cleartext stays allowed
         for development hosts only (the documented dev server is
         http://giwubible.test/api/, and 10.0.2.2 is the emulator's host). -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">giwubible.test</domain>
        <domain includeSubdomains="true">giwu.test</domain>
        <domain includeSubdomains="true">api.giwu.test</domain>
    </domain-config>
</network-security-config>
